<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="auth_background">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingVertical">25dp</item>
        <item name="android:paddingHorizontal">15dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@color/soft_blush</item>
    </style>
    <style name="auth_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">15dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dusty_lavender</item>
    </style>
    <style name="auth_input_fields">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:textColorHint">@color/dusty_mauve_light</item>
        <item name="android:backgroundTint">@color/dusty_lavender</item>
        <item name="android:layout_marginVertical">5dp</item>
        <item name="android:layout_marginHorizontal">25dp</item>
    </style>
    <style name="forgot_password">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">25dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dusty_mauve_dark</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="button_row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">15dp</item>
    </style>
    <style name="auth_navigate_button">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/auth_button</item>
    </style>
    <style name="auth_submit_button">
        <item name="android:layout_width">115dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/auth_button</item>
    </style>
</resources>