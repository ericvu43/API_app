<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="menu_background">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingVertical">25dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@color/soft_blush</item>
    </style>
    <style name="top_bar">
        <item name="android:layout_width">410dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="menu_button">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">35sp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/menu_button</item>
    </style>
    <style name="filter_spinner">
        <item name="android:layout_width">185dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/filter_spinner</item>
    </style>
    <style name="add_button">
        <item name="android:layout_width">115dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/new_button</item>
    </style>
    <style name="saved_call_recyclerview">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginVertical">15dp</item>
    </style>
    <style name="saved_bar">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:layout_marginVertical">5dp</item>
        <item name="android:background">@drawable/saved_call_background</item>
    </style>
    <style name="name_text">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mauve_shadow_light</item>
    </style>
    <style name="description_text">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/mauve_shadow_light</item>
    </style>
    <style name="delete_button">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">-3dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/delete_button</item>
    </style>
</resources>