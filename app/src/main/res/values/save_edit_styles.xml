<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="save_edit_background">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingVertical">25dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@color/soft_blush</item>
    </style>
    <style name="save_edit_title_bar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>
    <style name="save_edit_back_button">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">-15dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="android:textSize">35sp</item>
        <item name="backgroundTint">@color/mauve_shadow_light</item>
        <item name="android:background">@drawable/menu_button</item>
    </style>
    <style name="save_edit_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dusty_lavender</item>
    </style>
    <style name="save_edit_scroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="save_edit_label">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:layout_marginTop">-5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>
    <style name="save_edit_field">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/text_background</item>
    </style>
    <style name="save_edit_separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_marginVertical">17dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="backgroundTint">@color/dusty_lavender</item>
        <item name="android:background">@drawable/save_edit_button</item>
    </style>
    <style name="save_edit_button">
        <item name="android:layout_width">325dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginVertical">5dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/save_edit_button</item>
    </style>
    <style name="description_field">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:background">@drawable/text_background</item>
    </style>
    <style name="key_bar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">65dp</item>
        <item name="android:layout_marginTop">-15dp</item>
        <item name="android:layout_marginBottom">-15dp</item>
    </style>
    <style name="key_spacer">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">0dp</item>
    </style>
    <style name="key_field">
        <item name="android:layout_width">300dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:inputType">textPassword</item>
        <item name="android:background">@drawable/text_background</item>
    </style>
    <style name="key_check">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:checked">false</item>
        <item name="android:button">@drawable/checkbox</item>
        <item name="buttonTint">@null</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="key_toggle">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="info_label">
        <item name="android:layout_width">350dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dusty_lavender</item>
        <item name="android:textAlignment">center</item>
        <item name="android:inputType">text</item>
        <item name="android:background">@drawable/text_background</item>
    </style>
    <style name="response_bar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="response_json">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">250dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:visibility">invisible</item>
    </style>
    <style name="response_text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">250dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:background">@drawable/text_background</item>
    </style>
    <style name="toggle_button">
        <item name="android:layout_width">325dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginTop">17dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/save_edit_button</item>
    </style>
</resources>