<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_bar"
        style="@style/saved_bar">

        <TextView
            android:id="@+id/name_text"
            style="@style/name_text"
            android:text="Temporary Name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/description_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/delete_button"/>

        <TextView
            android:id="@+id/description_text"
            style="@style/description_text"
            android:text="Temporary Description"
            app:layout_constraintTop_toBottomOf="@id/name_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@id/name_text"
            app:layout_constraintRight_toRightOf="@id/name_text"/>

        <Button
            android:id="@+id/delete_button"
            style="@style/delete_button"
            android:text="@string/delete"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/name_text"
            app:layout_constraintRight_toRightOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>