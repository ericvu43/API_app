<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/auth_background"
    tools:context=".LoginActivity">

    <TextView
        style="@style/auth_title"
        android:text="@string/login"/>

    <EditText
        android:id="@+id/login_email"
        style="@style/auth_input_fields"
        android:hint="@string/email_address"
        android:autofillHints="emailAddress"
        android:inputType="textEmailAddress"/>

    <EditText
        android:id="@+id/login_password"
        style="@style/auth_input_fields"
        android:hint="@string/password"
        android:autofillHints="password"
        android:inputType="textPassword"/>

    <TextView
        android:id="@+id/forgot_password"
        style="@style/forgot_password"
        android:text="@string/forgot_password"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/button_row">

        <Button
            android:id="@+id/login_navigate_button"
            style="@style/auth_navigate_button"
            android:text="@string/navigate_signup"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/login_submit_button"/>

        <Button
            android:id="@+id/login_submit_button"
            style="@style/auth_submit_button"
            android:text="@string/login"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/login_navigate_button"
            app:layout_constraintRight_toRightOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>